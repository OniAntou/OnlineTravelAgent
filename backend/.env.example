# Backend Environment Variables
# Copy this file to .env and fill in the values

# Database connection string
DATABASE_URL="postgresql://user:password@localhost:5432/online_travel_agent?schema=public"

# Server port
PORT=3000

# JWT secret for token signing (REQUIRED - app will not start without it)
JWT_SECRET="your-super-secret-jwt-key-here"

# Admin password for admin panel Basic Auth (REQUIRED for admin access)
ADMIN_PASSWORD="your-admin-password-here"

# CORS allowed origins (comma-separated). Required when NODE_ENV=production.
CORS_ORIGINS="http://localhost:3000,http://10.0.2.2:3000"

# Reverse proxy trust setting for deployments behind Nginx/Render/Fly/Cloudflare/etc.
# Use 1 when exactly one trusted proxy sits in front of Express.
TRUST_PROXY="false"

# Local/test-only cash gateway for exercising the payment-success flow.
# It is always disabled when NODE_ENV=production; set false to disable locally too.
ALLOW_TEST_PAYMENTS="true"

# Optional legacy upload directory. Existing /uploads URLs remain readable;
# new catalogue images go to Supabase Storage.
# UPLOAD_DIR="/app/public/uploads"

# Supabase Storage for shared catalogue images. Keep the service role key on
# backend machines only; never expose it to Flutter or browser code.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="travel-media"
# Optional abandoned-upload cleanup settings (minutes).
PENDING_IMAGE_GRACE_MINUTES="60"
PENDING_IMAGE_CLEANUP_INTERVAL_MINUTES="60"

# VNPAY payment gateway
VNP_TMN_CODE=""
VNP_HASH_SECRET=""
VNP_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNP_API_URL="https://sandbox.vnpayment.vn/merchant_webapi/api/transaction"
VNP_RETURN_URL="http://10.0.2.2:3000/api/payment/vnpay/return"
