// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  PARTNER
  ADMIN
}

enum TripStatus {
  ONGOING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model Category {
  id   String @id @default(cuid())
  name String @unique

  @@map("categories")
}

model Destination {
  id            String   @id
  name          String
  location      String
  latitude      Float?
  longitude     Float?
  rating        String   @default("0.0")
  duration      String
  imagePath     String   @map("image_path")
  description   String
  price         Decimal  @db.Decimal(12, 2)
  reviewsCount  String   @default("0") @map("reviews_count")
  category      String
  isFavorite    Boolean  @default(false) @map("is_favorite")
  isRecommended Boolean  @default(false) @map("is_recommended")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  scheduleTemplates ScheduleTemplate[]
  favoritedBy       UserFavoriteDestination[]
  trips             Trip[]

  @@index([category])
  @@index([isRecommended])
  @@map("destinations")
}

model Trip {
  id          String     @id
  destination String
  location    String
  date        String
  guests      String
  status      TripStatus @default(ONGOING)
  imagePath   String     @map("image_path")
  isUpcoming  Boolean    @default(true) @map("is_upcoming")

  flightId      String?  @map("flight_id")
  hotelId       String?  @map("hotel_id")
  roomId        String?  @map("room_id")
  destinationId String?  @map("destination_id")
  tourPackageId String?  @map("tour_package_id")
  totalPrice    Decimal? @map("total_price") @db.Decimal(12, 2)
  isCustom      Boolean  @default(false) @map("is_custom")

  userId         String?      @map("user_id")
  user           User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  flight         Flight?      @relation(fields: [flightId], references: [id], onDelete: SetNull)
  hotel          Hotel?       @relation(fields: [hotelId], references: [id], onDelete: SetNull)
  room           Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  destinationRef Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  tourPackage    TourPackage? @relation(fields: [tourPackageId], references: [id], onDelete: SetNull)

  requestId String? @unique @map("request_id")

  promoCode String?  @map("promo_code")
  discount  Decimal? @default(0.00) @db.Decimal(12, 2)

  paymentMethod    String?        @map("payment_method")
  paymentStatus    PaymentStatus? @default(PENDING) @map("payment_status")
  paymentTxnRef    String?        @map("payment_txn_ref")
  paymentTxnNumber String?        @map("payment_txn_number")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  scheduleDays    TripScheduleDay[]
  scheduleUpdates TripScheduleUpdate[]

  @@index([userId])
  @@index([flightId])
  @@index([hotelId])
  @@index([roomId])
  @@index([destinationId])
  @@index([tourPackageId])
  @@index([isUpcoming])
  @@index([createdAt])
  @@map("trips")
}

model Flight {
  id            String   @id
  airline       String
  airlineLogo   String   @map("airline_logo")
  departure     String
  arrival       String
  departureTime String   @map("departure_time")
  arrivalTime   String   @map("arrival_time")
  price         Decimal  @db.Decimal(12, 2)
  duration      String
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")
  trips         Trip[]

  @@map("flights")
}

model DocumentItem {
  id          String @id
  title       String
  description String
  icon        String
  color       String

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([userId])
  @@map("document_items")
}

model Hotel {
  id          String   @id
  name        String
  location    String
  latitude    Float?
  longitude   Float?
  rating      String   @default("0.0")
  imagePath   String   @map("image_path")
  description String
  priceFrom   Decimal  @map("price_from") @db.Decimal(12, 2)
  address     String
  amenities   String[]

  partnerId String?  @map("partner_id")
  partner   User?    @relation("PartnerHotels", fields: [partnerId], references: [id])
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  rooms Room[]
  trips Trip[]

  @@index([location])
  @@index([partnerId])
  @@map("hotels")
}

model Room {
  id          String   @id
  hotelId     String   @map("hotel_id")
  name        String
  description String
  price       Decimal  @db.Decimal(12, 2)
  capacity    Int
  imagePath   String   @map("image_path")
  amenities   String[]

  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  trips     Trip[]

  @@index([hotelId])
  @@map("rooms")
}

model TourPackage {
  id            String   @id
  name          String
  description   String
  imagePath     String   @map("image_path")
  duration      String
  price         Decimal  @db.Decimal(12, 2)
  originalPrice Decimal? @map("original_price") @db.Decimal(12, 2)
  destinations  String[]
  includes      String[]
  departure     String
  departureDate String?  @map("departure_date")
  isPopular     Boolean  @default(false) @map("is_popular")
  includesGuide Boolean  @default(true) @map("includes_guide")
  guideFee      Decimal  @default(50.00) @map("guide_fee") @db.Decimal(12, 2)

  partnerId String? @map("partner_id")
  partner   User?   @relation("PartnerTours", fields: [partnerId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  scheduleTemplates ScheduleTemplate[]
  trips             Trip[]

  @@index([createdAt])
  @@index([partnerId])
  @@map("tour_packages")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  trips                Trip[]
  reviews              Review[]
  hotels               Hotel[]                   @relation("PartnerHotels")
  tours                TourPackage[]             @relation("PartnerTours")
  documents            DocumentItem[]
  favoriteDestinations UserFavoriteDestination[]
  refreshTokens        RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model UserFavoriteDestination {
  userId        String   @map("user_id")
  destinationId String   @map("destination_id")
  createdAt     DateTime @default(now()) @map("created_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@id([userId, destinationId])
  @@index([destinationId])
  @@map("user_favorite_destinations")
}

model Review {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  rating     Int
  comment    String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@index([userId])
  @@map("reviews")
}

model ScheduleTemplate {
  id            String  @id @default(cuid())
  name          String
  sourceType    String  @map("source_type")
  tourPackageId String? @map("tour_package_id")
  destinationId String? @map("destination_id")

  tourPackage TourPackage?          @relation(fields: [tourPackageId], references: [id], onDelete: Cascade)
  destination Destination?          @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  days        ScheduleTemplateDay[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([sourceType])
  @@index([tourPackageId])
  @@index([destinationId])
  @@map("schedule_templates")
}

model ScheduleTemplateDay {
  id         String  @id @default(cuid())
  templateId String  @map("template_id")
  dayNumber  Int     @map("day_number")
  title      String?

  template ScheduleTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  items    ScheduleTemplateItem[]

  @@unique([templateId, dayNumber])
  @@index([templateId])
  @@index([dayNumber])
  @@map("schedule_template_days")
}

model ScheduleTemplateItem {
  id           String  @id @default(cuid())
  dayId        String  @map("day_id")
  startTime    String  @map("start_time")
  endTime      String? @map("end_time")
  title        String
  description  String?
  locationName String? @map("location_name")
  latitude     Float?
  longitude    Float?
  sortOrder    Int     @default(0) @map("sort_order")

  day ScheduleTemplateDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([dayId])
  @@index([sortOrder])
  @@map("schedule_template_items")
}

model TripScheduleDay {
  id        String    @id @default(cuid())
  tripId    String    @map("trip_id")
  dayNumber Int       @map("day_number")
  date      DateTime?
  title     String?

  trip  Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  items TripScheduleItem[]

  @@unique([tripId, dayNumber])
  @@index([tripId])
  @@index([dayNumber])
  @@map("trip_schedule_days")
}

model TripScheduleItem {
  id             String   @id @default(cuid())
  dayId          String   @map("day_id")
  startTime      String   @map("start_time")
  endTime        String?  @map("end_time")
  title          String
  description    String?
  locationName   String?  @map("location_name")
  latitude       Float?
  longitude      Float?
  sortOrder      Int      @default(0) @map("sort_order")
  statusOverride String?  @map("status_override")
  note           String?
  updatedAt      DateTime @updatedAt @map("updated_at")

  day TripScheduleDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([dayId])
  @@index([sortOrder])
  @@map("trip_schedule_items")
}

model TripScheduleUpdate {
  id        String   @id @default(cuid())
  tripId    String   @map("trip_id")
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([createdAt])
  @@map("trip_schedule_updates")
}

model PromoCode {
  id                 String    @id @default(cuid())
  code               String    @unique
  discountPercentage Decimal?  @map("discount_percentage") @db.Decimal(5, 2)
  discountAmount     Decimal?  @map("discount_amount") @db.Decimal(12, 2)
  maxUses            Int       @default(100) @map("max_uses")
  currentUses        Int       @default(0) @map("current_uses")
  validUntil         DateTime? @map("valid_until")
  isActive           Boolean   @default(true) @map("is_active")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("promo_codes")
}
